# Hosted PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/white_house_eatry?schema=public"

# Use a long random value in production.
JWT_SECRET="replace-with-a-long-random-production-secret"
JWT_EXPIRES_IN="7d"

# Public frontend URL, or comma-separated frontend URLs.
CLIENT_ORIGIN="https://white-house-ddzi.vercel.app"
# ALLOWED_ORIGINS takes precedence over CLIENT_ORIGIN when provided.
# ALLOWED_ORIGINS="https://white-house-ddzi.vercel.app,https://your-custom-domain.com"

# Most hosts provide PORT automatically.
PORT=4000

# Seed/admin values. Change before running the seed command.
ADMIN_EMAIL="muazusabo6@gmail.com"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
ADMIN_NAME="Restaurant Owner"

# Optional production safeguards.
CLAMAV_PATH="/usr/bin/clamscan"
CLAMAV_REQUIRED="true"
SENTRY_DSN=""
NODE_ENV="production"
